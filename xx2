local Solving = false
local Pending = false

local Solve

local function QueueSolve()
    if not isActive or not GameRunning.Value then LastSig = nil; ClearAll(); return end
    if Solving then Pending = true; return end
    Solving = true
    task.spawn(function()
        Solving = false
        local ok, err = pcall(Solve)
        if not ok then warn("[PhantomBit] " .. tostring(err)) end
        if Pending then Pending = false; QueueSolve() end
    end)
end

function Solve()
    if not isActive or not GameRunning.Value then ClearAll(); return end
    Reflag()

    local hasMines = MinesVal ~= nil
    local mineTotal = hasMines and MinesVal.Value or 0
    TotalMines = mineTotal

    -- [PALETTE] learn covered / revealed colours before classifying tiles
    if CFG.AutoLearnPalette then
        local anyNumber = false
        local colorsSeen = {}
        for t in next, Adjacency do
            local k = RGBKey(t.Color)
            colorsSeen[k] = true
            if GetNumber(t) > 0 then
                anyNumber = true
                if not GREEN_KEYS[k] then
                    LearnedRevealed[k] = true
                    LearnedCovered[k] = nil
                end
            elseif HasFlag(t) then
                if not BEIGE_KEYS[k] and not LearnedRevealed[k] then
                    LearnedCovered[k] = true
                end
            end
        end
        if not anyNumber then
            -- nothing revealed yet: every colour on the board is a covered colour
            for k in next, colorsSeen do
                if not BEIGE_KEYS[k] and not LearnedRevealed[k] then
                    LearnedCovered[k] = true
                end
            end
        end
        local nLearned = 0
        for _ in next, LearnedRevealed do nLearned += 1 end
        if nLearned > 6 then
            warn("[PhantomBit] Palette learning looks wrong (too many revealed colours); resetting. Use CFG.CoveredColors / CFG.RevealedColors or set AutoLearnPalette = false.")
            ResetLearnedPalette()
        end
    end

    local greenTiles = {}
    local beigeSet = {}
    local flagged = {}
    local sig = (TileCount * 2246822519 + mineTotal * 3266489917) % 4294967291

    for t in next, Adjacency do
        local k = RGBKey(t.Color)
        if IsRevealedKey(k) then -- [PALETTE] was BEIGE_KEYS[k]
            beigeSet[t] = true
            sig = (sig + (k + GetNumber(t) * 97 + 11) * 31 + 7) % 4294967291
        elseif IsCoveredKey(k) then -- [PALETTE] was GREEN_KEYS[k]
            greenTiles[#greenTiles+1] = t
            local fl = HasFlag(t)
            flagged[t] = fl
            sig = (sig + (k + (fl and 6151 or 0)) * 31 + 7) % 4294967291
        else
            sig = (sig + k * 31 + 7) % 4294967291
        end
    end
    if sig == LastSig then return end
    if BoundsDirty then RefreshBounds() end

    local state = {}
    for i = 1, #greenTiles do state[greenTiles[i]] = 0 end
    if CFG.TrustFlags then
        for i = 1, #greenTiles do
            local t = greenTiles[i]
            if flagged[t] then state[t] = 2 end
        end
    end

    local cons = {}
    local consOf = {}
    local contra = false

    local function BuildConstraints()
        cons, consOf, contra = {}, {}, false
        for b in next, beigeSet do
            local n = GetNumber(b)
            if n > 0 then
                local c = { Set={}, List={}, Rem=n }
                local nbs = Adjacency[b]
                for i = 1, #nbs do
                    local nb = nbs[i]
                    local s = state[nb]
                    if s == 0 then
                        c.Set[nb] = true
                        c.List[#c.List+1] = nb
                        local lst = consOf[nb]
                        if not lst then lst = {}; consOf[nb] = lst end
                        lst[#lst+1] = c
                    elseif s == 2 then
                        c.Rem -= 1
                    end
                end
                if #c.List > 0 then
                    cons[#cons+1] = c
                elseif c.Rem ~= 0 then
                    contra = true
                end
            end
        end
    end

    local function Propagate()
        local changed = false
        for i = 1, #cons do
            local c = cons[i]
            local target = (c.Rem == 0) and 1 or (c.Rem >= #c.List and 2 or 0)
            if target ~= 0 then
                local list = c.List
                for j = 1, #list do
                    local t = list[j]
                    if state[t] == 0 then state[t] = target; changed = true end
                end
            end
        end
        return changed
    end

    local function SubsetClosure()
        local resolved = false
        for _ = 1, 32 do
            local n, seen, newOnes, added = #cons, {}, {}, false
            for i = 1, n do
                local ids = {}
                local lst = cons[i].List
                for j = 1, #lst do ids[#ids+1] = TileIndex[lst[j]] end
                table.sort(ids)
                local h = 0
                for j = 1, #ids do h = (h * 131 + ids[j]) % 4294967291 end
                seen[h] = true
            end
            for i = 1, n do
                local a = cons[i]
                local cand = {}
                local aList = a.List
                for j = 1, #aList do
                    local t = aList[j]
                    local lst = consOf[t]
                    if lst then
                        for k = 1, #lst do
                            local b = lst[k]
                            if b ~= a and #b.List > #a.List then cand[b] = true end
                        end
                    end
                end
                for b in next, cand do
                    local sub = true
                    local aSet = a.Set
                    for j = 1, #aList do
                        if not b.Set[aList[j]] then sub = false; break end
                    end
                    if sub then
                        local rem = b.Rem - a.Rem
                        local diff = {}
                        local bList = b.List
                        for j = 1, #bList do
                            local t = bList[j]
                            if not aSet[t] then diff[#diff+1] = t end
                        end
                        if #diff > 0 then
                            if rem == 0 or rem == #diff then
                                local s = (rem == 0) and 1 or 2
                                for j = 1, #diff do
                                    local t = diff[j]
                                    if state[t] == 0 then state[t] = s; resolved = true end
                                end
                            else
                                local ids = {}
                                for j = 1, #diff do ids[#ids+1] = TileIndex[diff[j]] end
                                table.sort(ids)
                                local h = 0
                                for j = 1, #ids do h = (h*131+ids[j])%4294967291 end
                                if not seen[h] then
                                    seen[h] = true
                                    local nc = { Set={}, List=diff, Rem=rem }
                                    for j = 1, #diff do
                                        local t = diff[j]
                                        nc.Set[t] = true
                                        local lst = consOf[t]
                                        if not lst then lst={}; consOf[t]=lst end
                                        lst[#lst+1] = nc
                                    end
                                    newOnes[#newOnes+1] = nc
                                    added = true
                                end
                            end
                        end
                    end
                end
            end
            for i = 1, #newOnes do cons[#cons+1] = newOnes[i] end
            if resolved or not added then break end
        end
        return resolved
    end

    local function GaussianElim()
        if #cons == 0 then return false end
        local tileList, tilePos = {}, {}
        for i = 1, #cons do
            local lst = cons[i].List
            for j = 1, #lst do
                local t = lst[j]
                if not tilePos[t] then
                    tileList[#tileList+1] = t
                    tilePos[t] = #tileList
                end
            end
        end
        local nv = #tileList
        local nc = #cons
        if nv == 0 then return false end

        local mat = {}
        for ri = 1, nc do
            local c = cons[ri]
            local row = table.create(nv + 1, 0)
            local lst = c.List
            for j = 1, #lst do
                row[tilePos[lst[j]]] = 1
            end
            row[nv + 1] = c.Rem
            mat[ri] = row
        end

        local pivot = {}
        local pr = 1
        for col = 1, nv do
            local found = nil
            for r = pr, nc do
                if mat[r][col] == 1 then found = r; break end
            end
            if found then
                mat[pr], mat[found] = mat[found], mat[pr]
                pivot[col] = pr
                for r = 1, nc do
                    if r ~= pr and mat[r][col] == 1 then
                        local rowR = mat[r]
                        local rowP = mat[pr]
                        for c2 = col, nv + 1 do
                            rowR[c2] = rowR[c2] - rowP[c2]
                            if rowR[c2] < 0 then rowR[c2] += 2 end
                        end
                    end
                end
                pr += 1
            end
        end

        local resolved = false
        for r = 1, nc do
            local row = mat[r]
            local rhs = row[nv + 1]
            local nonzero, lastCol = 0, 0
            for col = 1, nv do
                if row[col] ~= 0 then nonzero += 1; lastCol = col end
            end
            if nonzero == 1 then
                local t = tileList[lastCol]
                if rhs == 0 and state[t] == 0 then
                    state[t] = 1; resolved = true
                elseif rhs == 1 and state[t] == 0 then
                    state[t] = 2; resolved = true
                end
            end
        end
        return resolved
    end

    local function Deduct()
        for _ = 1, 64 do
            BuildConstraints()
            if contra then return false end
            for i = 1, #cons do
                local c = cons[i]
                if c.Rem < 0 or c.Rem > #c.List then return false end
            end
            local ch = Propagate()
            if SubsetClosure() then ch = true end
            if GaussianElim() then ch = true end
            if not ch then break end
        end
        return true
    end

    local function ComputeBudget()
        if not hasMines then return math.huge end
        local found = 0
        for i = 1, #greenTiles do
            local t = greenTiles[i]
            if state[t] == 2 then
                if not (CFG.MinesValueIsRemaining and CFG.TrustFlags and flagged[t]) then
                    found += 1
                end
            end
        end
        return math.max(0, math.floor(
            CFG.MinesValueIsRemaining and mineTotal - found or mineTotal - found + 0.5
        ))
    end

    local function MakeSearch(tiles)
        local n = #tiles
        local tIdx = {}
        for i = 1, n do tIdx[tiles[i]] = i end

        local cSet, cList = {}, {}
        for i = 1, n do
            local lst = consOf[tiles[i]]
            if lst then
                for j = 1, #lst do
                    local c = lst[j]
                    if not cSet[c] then cSet[c]=true; cList[#cList+1]=c end
                end
            end
        end
        local nc = #cList
        local vCon = table.create(n)
        local cVar = table.create(nc)
        local cRem = table.create(nc)
        for i = 1, n do vCon[i] = {} end
        for ci = 1, nc do
            local c = cList[ci]
            cRem[ci] = c.Rem
            local vars = {}
            local cListItems = c.List
            for j = 1, #cListItems do
                local vi = tIdx[cListItems[j]]
                if vi then
                    vars[#vars+1] = vi
                    local vc = vCon[vi]; vc[#vc+1] = ci
                end
            end
            cVar[ci] = vars
        end

        local placed = table.create(nc, 0)
        local left = table.create(nc, 0)
        for ci = 1, nc do left[ci] = #cVar[ci] end
        local asgn = table.create(n, -1)
        local trail = {}
        local mines = {}
        local count = 0

        local propQ = {}

        local function assign(v, val)
            asgn[v] = val; trail[#trail+1] = v; count += 1
            if val == 1 then mines[#mines+1] = v end
            local vc = vCon[v]
            for i = 1, #vc do
                local ci = vc[i]
                left[ci] -= 1
                if val == 1 then placed[ci] += 1 end
                propQ[#propQ+1] = ci
            end
        end

        local function prop()
            while #propQ > 0 do
                local ci = propQ[#propQ]; propQ[#propQ] = nil
                local need = cRem[ci] - placed[ci]
                local lft = left[ci]
                if need < 0 or need > lft then
                    for i = 1, #propQ do propQ[i] = nil end
                    return false
                end
                if lft > 0 then
                    local forced = (need == 0) and 0 or (need == lft and 1 or -1)
                    if forced >= 0 then
                        local cVars = cVar[ci]
                        for i = 1, #cVars do
                            local vi = cVars[i]
                            if asgn[vi] == -1 then assign(vi, forced) end
                        end
                    end
                end
            end
            return true
        end

        local function undo(mark)
            while #trail > mark do
                local v = trail[#trail]; trail[#trail] = nil
                local val = asgn[v]; asgn[v] = -1; count -= 1
                if val == 1 then mines[#mines] = nil end
                local vc = vCon[v]
                for i = 1, #vc do
                    local ci = vc[i]
                    left[ci] += 1
                    if val == 1 then placed[ci] -= 1 end
                end
            end
        end

        return {
            N=n, NC=nc, VCon=vCon, CVar=cVar, CRem=cRem,
            Placed=placed, Left=left, Asgn=asgn,
            Trail=trail, Mines=mines,
            Count=function() return count end,
            Assign=assign, Prop=prop, Undo=undo,
        }
    end

    local nodesBudget = { n = 0 }
    local deadline = os.clock() + CFG.MaxSolveTime
    local maxBudget = math.huge

    local function Enumerate(tiles)
        local s = MakeSearch(tiles)
        local n, nc = s.N, s.NC
        local cVar = s.CVar; local cRem = s.CRem
        local placed = s.Placed; local left = s.Left
        local asgn = s.Asgn; local trail = s.Trail
        local mines = s.Mines
        local assign = s.Assign; local prop = s.Prop; local undo = s.Undo
        local vCon = s.VCon
        local cbm = {}
        local freq = table.create(n)
        local total = 0
        local aborted = false
        local localN = 0

        local function pickVar()
            local bestV, bestSlack, bestDeg = -1, math.huge, -1
            for ci = 1, nc do
                if left[ci] > 0 then
                    local slack = left[ci] - (cRem[ci] - placed[ci])
                    if slack < bestSlack then
                        bestSlack = slack; bestV = -1; bestDeg = -1
                        local cVars = cVar[ci]
                        for i = 1, #cVars do
                            local v = cVars[i]
                            if asgn[v] == -1 then
                                local d = #vCon[v]
                                if d > bestDeg then bestDeg = d; bestV = v end
                            end
                        end
                    end
                end
            end
            return bestV
        end

        local function bt()
            if aborted then return end
            localN += 1
            nodesBudget.n += 1
            if localN % 512 == 0 and
               (nodesBudget.n >= CFG.MaxNodes or os.clock() > deadline) then
                aborted = true; return
            end
            if s.Count() == n then
                total += 1
                local m = #mines
                cbm[m] = (cbm[m] or 0) + 1
                for i = 1, #mines do
                    local v = mines[i]
                    local f = freq[v]
                    if not f then f = {}; freq[v] = f end
                    f[m] = (f[m] or 0) + 1
                end
                if total >= CFG.MaxSolutions then aborted = true end
                return
            end
            local v = pickVar()
            if v < 0 then return end
            local mark = #trail
            assign(v, 0); if prop() then bt() end; undo(mark)
            if aborted then return end
            if #mines + 1 <= maxBudget then
                assign(v, 1); if prop() then bt() end; undo(mark)
            end
        end

        bt()
        return cbm, freq, total, aborted
    end

    local function SamplePart(tiles)
        local s = MakeSearch(tiles)
        local n = s.N
        local vCon = s.VCon
        local cRem = s.CRem
        local placed = s.Placed; local left = s.Left
        local asgn = s.Asgn; local mines = s.Mines
        local assign = s.Assign; local prop = s.Prop; local undo = s.Undo

        local order = table.create(n)
        for i = 1, n do order[i] = i end

        local density
        if hasMines and TotalTiles then
            local unrevealed = math.max(1, TotalTiles - TileCount + #greenTiles)
            density = math.clamp(mineTotal / unrevealed, 0.02, 0.98)
        elseif hasMines then
            density = math.clamp(mineTotal / math.max(1, #greenTiles), 0.02, 0.98)
        else
            density = 0.21
        end

        local cbmS = {}
        local freqS = table.create(n)
        local valid = 0

        for _ = 1, CFG.MonteCarloSamples do
            if _ % 32 == 0 and os.clock() > deadline then break end
            for i = n, 2, -1 do
                local j = math.random(i)
                order[i], order[j] = order[j], order[i]
            end
            local ok = true
            for pos = 1, n do
                local v = order[pos]
                if asgn[v] == -1 then
                    local canMine, canSafe, pn, pd = true, true, 0, 0
                    local vc = vCon[v]
                    for i = 1, #vc do
                        local ci = vc[i]
                        local need = cRem[ci] - placed[ci]
                        if need <= 0 then canMine = false end
                        if need > left[ci] - 1 then canSafe = false end
                        pn += need; pd += left[ci]
                    end
                    if canMine and canSafe then
                        local val = (math.random() < (pd > 0 and pn/pd or density)) and 1 or 0
                        assign(v, val)
                        if not prop() then ok = false; break end
                    elseif canMine then
                        assign(v, 1)
                        if not prop() then ok = false; break end
                    elseif canSafe then
                        assign(v, 0)
                        if not prop() then ok = false; break end
                    else
                        ok = false; break
                    end
                end
            end
            if ok and s.Count() == n then
                valid += 1
                local m = #mines
                cbmS[m] = (cbmS[m] or 0) + 1
                for i = 1, #mines do
                    local v = mines[i]
                    local f = freqS[v]
                    if not f then f = {}; freqS[v] = f end
                    f[m] = (f[m] or 0) + 1
                end
            end
            undo(0)
        end
        return cbmS, freqS, valid
    end

    local ok = Deduct()
    if not ok and CFG.TrustFlags then
        for i = 1, #greenTiles do state[greenTiles[i]] = 0 end
        Deduct()
    end

    do
        local b = ComputeBudget()
        if b ~= math.huge then
            local unknowns = {}
            for i = 1, #greenTiles do
                local t = greenTiles[i]
                if state[t] == 0 then unknowns[#unknowns+1] = t end
            end
            if #unknowns > 0 then
                if b == 0 then
                    for i = 1, #unknowns do state[unknowns[i]] = 1 end; Deduct()
                elseif b == #unknowns then
                    for i = 1, #unknowns do state[unknowns[i]] = 2 end; Deduct()
                end
            end
        end
    end
    if not isActive or not GameRunning.Value then ClearAll(); return end

    local prob = {}
    local freeProb = 0.5
    local frontier = {}
    local freeTiles = {}
    local failedParts = {}

    for cascade = 1, CFG.MaxCascade do
        if os.clock() > deadline then break end

        local budget = ComputeBudget()
        local nUnknown = 0
        for i = 1, #greenTiles do
            if state[greenTiles[i]] == 0 then nUnknown += 1 end
        end
        if budget ~= math.huge then
            budget = math.min(budget, nUnknown)
            maxBudget = budget
        end

        prob, frontier, freeTiles = {}, {}, {}
        for i = 1, #greenTiles do
            local t = greenTiles[i]
            if state[t] == 0 then
                if consOf[t] then frontier[#frontier+1] = t
                else freeTiles[#freeTiles+1] = t end
            end
        end

        local parts, visited = {}, {}
        for i = 1, #frontier do
            local seed = frontier[i]
            if not visited[seed] then
                local component = {}
                local q, qh = {seed}, 1
                visited[seed] = true
                while qh <= #q do
                    local cur = q[qh]; qh += 1
                    component[#component+1] = cur
                    local lst = consOf[cur]
                    if lst then
                        for j = 1, #lst do
                            local cListItems = lst[j].List
                            for k = 1, #cListItems do
                                local u = cListItems[k]
                                if not visited[u] then
                                    visited[u] = true; q[#q+1] = u
                                end
                            end
                        end
                    end
                end
                table.sort(component, function(a, b)
                    local ax, az = TileGridPos(a)
                    local bx, bz = TileGridPos(b)
                    if ax and bx then
                        if ax ~= bx then return ax < bx end
                        if az ~= bz then return az < bz end
                    end
                    return (TileIndex[a] or 0) < (TileIndex[b] or 0)
                end)
                parts[#parts+1] = component
            end
        end

        local partData = {}
        failedParts = {}
        for i = 1, #parts do
            local tiles = parts[i]
            local done = false
            if #tiles <= CFG.MaxBruteForce then
                local cbm, freq, total, aborted = Enumerate(tiles)
                if not aborted and total > 0 then
                    partData[#partData+1] = { Tiles=tiles, Cbm=cbm, Freq=freq, Tot=total }
                    done = true
                end
            end
            if not done then
                local cbmS, freqS, valid = SamplePart(tiles)
                if valid > 0 then
                    partData[#partData+1] = { Tiles=tiles, Cbm=cbmS, Freq=freqS, Tot=valid }
                else
                    failedParts[#failedParts+1] = tiles
                end
            end
        end

        if not isActive or not GameRunning.Value then ClearAll(); return end

        if hasMines and budget ~= math.huge and #partData > 0 then
            local frontierMin, frontierMax = 0, 0
            for j = 1, #partData do
                local pdt = partData[j]
                local lo, hi = math.huge, 0
                for k in next, pdt.Cbm do
                    if k < lo then lo = k end
                    if k > hi then hi = k end
                end
                if lo < math.huge then
                    frontierMin += lo
                    frontierMax += hi
                end
            end
            local freeMin = budget - frontierMax
            local freeMax = budget - frontierMin
            local nFree = #freeTiles
            if nFree > 0 then
                if freeMax <= 0 then
                    for j = 1, #freeTiles do
                        local t = freeTiles[j]
                        if state[t] == 0 then state[t] = 1 end
                    end
                    Deduct()
                elseif freeMin >= nFree then
                    for j = 1, #freeTiles do
                        local t = freeTiles[j]
                        if state[t] == 0 then state[t] = 2 end
                    end
                    Deduct()
                end
            end
            for j = 1, #partData do
                local pdt = partData[j]
                local lo, hi = math.huge, 0
                for k in next, pdt.Cbm do
                    if k < lo then lo = k end
                    if k > hi then hi = k end
                end
                if lo == hi and lo < math.huge then
                    local tot = pdt.Tot
                    for v, fk in next, pdt.Freq do
                        local cnt = fk[lo] or 0
                        local t = pdt.Tiles[v]
                        if state[t] == 0 then
                            if cnt == tot then
                                state[t] = 2
                            elseif cnt == 0 then
                                state[t] = 1
                            end
                        end
                    end
                end
            end
        end

        local allUnknown = {}
        for i = 1, #greenTiles do
            local t = greenTiles[i]
            if state[t] == 0 then allUnknown[#allUnknown+1] = t end
        end
        local endgameThreshold = CFG.MaxBruteForce
        if #allUnknown > 0 and #allUnknown <= endgameThreshold
           and #allUnknown <= 60 then
            local cbmG, freqG, totalG, abortedG = Enumerate(allUnknown)
            if not abortedG and totalG > 0 then
                partData = {{ Tiles = allUnknown, Cbm = cbmG, Freq = freqG, Tot = totalG }}
                freeTiles = {}
            end
        end

        local NEG = -math.huge
        local p = #partData
        local weighted = false
        freeProb = 0.5

        local function LogAdd(a, b)
            if a == NEG then return b end
            if b == NEG then return a end
            if a < b then a, b = b, a end
            return a + math.log(1 + math.exp(b - a))
        end

        local function LogComb(n, k)
            if k < 0 or k > n then return NEG end
            k = math.min(k, n - k)
            local s = 0
            for i = 1, k do s += math.log(n-k+i) - math.log(i) end
            return s
        end

        if hasMines and p > 0 then
            local pre = { [0] = { [0] = 0 } }
            for i = 1, p do
                local row = {}
                for m, w in next, pre[i-1] do
                    for k, c in next, partData[i].Cbm do
                        local nm = m + k
                        if nm <= budget then
                            row[nm] = LogAdd(row[nm] or NEG, w + math.log(c))
                        end
                    end
                end
                local mx = NEG
                for _, w in next, row do if w > mx then mx = w end end
                if mx > NEG then
                    local cut = mx - 40
                    for m, w in next, row do if w < cut then row[m] = nil end end
                end
                pre[i] = row
            end

            local suf = { [p+1] = { [0] = 0 } }
            for i = p, 1, -1 do
                local row = {}
                for m, w in next, suf[i+1] do
                    for k, c in next, partData[i].Cbm do
                        local nm = m + k
                        if nm <= budget then
                            row[nm] = LogAdd(row[nm] or NEG, w + math.log(c))
                        end
                    end
                end
                local mx = NEG
                for _, w in next, row do if w > mx then mx = w end end
                if mx > NEG then
                    local cut = mx - 40
                    for m, w in next, row do if w < cut then row[m] = nil end end
                end
                suf[i] = row
            end

            local f = #freeTiles
            local lcCache = {}
            local function LC(k)
                local v = lcCache[k]
                if v == nil then v = LogComb(f, k); lcCache[k] = v end
                return v
            end

            local wTotal = NEG
            for m, wgt in next, pre[p] do
                wTotal = LogAdd(wTotal, wgt + LC(budget - m))
            end

            if wTotal > NEG then
                local ops = 0
                for i = 1, p do
                    local a, b = 0, 0
                    for _ in next, pre[i-1] do a += 1 end
                    for _ in next, suf[i+1] do b += 1 end
                    ops += a * b
                end
                if ops <= CFG.MaxDPOps then
                    weighted = true
                    for i = 1, #partData do
                        local pdt = partData[i]
                        local others = {}
                        for m1, w1 in next, pre[i-1] do
                            for m2, w2 in next, suf[i+1] do
                                local x = m1 + m2
                                others[x] = LogAdd(others[x] or NEG, w1 + w2)
                            end
                        end
                        local wo = {}
                        for k in next, pdt.Cbm do
                            local acc = NEG
                            for x, wgt in next, others do
                                acc = LogAdd(acc, wgt + LC(budget - k - x))
                            end
                            wo[k] = acc
                        end
                        for v, fk in next, pdt.Freq do
                            local num = NEG
                            for k, c in next, fk do
                                num = LogAdd(num, math.log(c) + (wo[k] or NEG))
                            end
                            prob[pdt.Tiles[v]] = math.clamp(math.exp(num - wTotal), 0, 1)
                        end
                        local tiles = pdt.Tiles
                        for j = 1, #tiles do
                            local t = tiles[j]
                            if prob[t] == nil then prob[t] = 0 end
                        end
                    end
                    if f > 0 then
                        local num = NEG
                        for m, wgt in next, pre[p] do
                            local fm = budget - m
                            if fm > 0 then
                                num = LogAdd(num, wgt + LC(fm) + math.log(fm))
                            end
                        end
                        freeProb = math.clamp(math.exp(num - wTotal) / f, 0, 1)
                    else
                        freeProb = 1
                    end
                end
            end
        end

        if not weighted then
            for i = 1, #partData do
                local pdt = partData[i]
                for v, fk in next, pdt.Freq do
                    local s = 0
                    for _, c in next, fk do s += c end
                    prob[pdt.Tiles[v]] = s / pdt.Tot
                end
                local tiles = pdt.Tiles
                for j = 1, #tiles do
                    local t = tiles[j]
                    if prob[t] == nil then prob[t] = 0 end
                end
            end
            if #freeTiles > 0 then
                if hasMines then
                    if TotalTiles then
                        local unrevealed = TotalTiles - TileCount
                        local unknownMines = math.max(0, mineTotal - (#greenTiles - nUnknown))
                        freeProb = math.clamp(unknownMines / math.max(1, unrevealed), 0, 1)
                    else
                        freeProb = math.clamp(budget / math.max(1, nUnknown), 0, 1)
                    end
                else
                    freeProb = 0.25
                end
            end
        end

        local resolved = false
        for t, pv in next, prob do
            if pv <= 1e-7 then
                state[t] = 1; resolved = true
            elseif pv >= 1 - 1e-7 then
                state[t] = 2; resolved = true
            end
        end
        if not resolved or cascade == CFG.MaxCascade then break end
        Deduct()
    end

    BuildConstraints()
    frontier, freeTiles = {}, {}
    for i = 1, #greenTiles do
        local t = greenTiles[i]
        if state[t] == 0 then
            if consOf[t] then frontier[#frontier+1] = t
            else freeTiles[#freeTiles+1] = t end
        end
    end

    local function InfoScore(t)
        local gx, gz = TileGridPos(t)
        local s = 0
        local nbs = Adjacency[t]
        for i = 1, #nbs do
            local nb = nbs[i]
            if state[nb] == 0 then
                s += 1
                if consOf[nb] then s += 2 end
            end
        end
        if gx and IsEdge(gx, gz) then
            s -= 1
            if IsCorner(gx, gz) then s -= 1 end
        end
        return s
    end

    local bestTile, bestProb, bestInfo = nil, math.huge, -1
    local TIE = 0.002

    local function Consider(t, pv)
        if not t then return end
        local inf = InfoScore(t)
        if pv < bestProb - TIE
        or (math.abs(pv - bestProb) <= TIE and inf > bestInfo) then
            bestProb = pv; bestTile = t; bestInfo = inf
        end
    end

    for t, pv in next, prob do
        if state[t] == 0 then Consider(t, pv) end
    end

    local function Centroid(tiles)
        local cx, cy, cz, n = 0, 0, 0, #tiles
        for i = 1, n do
            local p = tiles[i].Position; cx += p.X; cy += p.Y; cz += p.Z
        end
        return Vector3.new(cx/n, cy/n, cz/n)
    end
    local function Nearest(tiles, c)
        local best, bd = tiles[1], math.huge
        for i = 1, #tiles do
            local t = tiles[i]
            local d = (t.Position - c).Magnitude
            if d < bd then bd = d; best = t end
        end
        return best
    end

    for i = 1, #failedParts do
        local tiles = failedParts[i]
        local est = hasMines
            and math.clamp(mineTotal / math.max(1, #greenTiles), 0, 1)
            or 0.5
        Consider(Nearest(tiles, Centroid(tiles)), est)
    end

    if #freeTiles > 0 then
        local bf, bfp, bi = nil, math.huge, -1
        for i = 1, #freeTiles do
            local t = freeTiles[i]
            local inf = InfoScore(t)
            if freeProb < bfp - 1e-9
            or (math.abs(freeProb - bfp) <= 1e-9 and inf > bi) then
                bfp = freeProb; bf = t; bi = inf
            end
        end
        if bf then Consider(bf, bfp) end
    end

    if not isActive or not GameRunning.Value then ClearAll(); return end

    local newSafeList = {}
    local newMineList = {}
    local drawn = {}

    for i = 1, #greenTiles do
        local t = greenTiles[i]
        local s = state[t]
        local onBoundary = false
        local nbs = Adjacency[t]
        for j = 1, #nbs do
            if beigeSet[nbs[j]] then onBoundary = true; break end
        end

        if s == 2 and onBoundary then
            Draw(t, COLOR.Mine, "X", HasFlag(t)); drawn[t] = true
            newMineList[t] = true
        elseif s == 1 and onBoundary then
            Draw(t, COLOR.Safe, "", false); drawn[t] = true
            newSafeList[t] = true
        elseif s == 0 and onBoundary then
            local pv = prob[t]
            local col = (t == bestTile) and COLOR.Best
                     or (pv and ProbColor(pv) or COLOR.Unknown)
            Draw(t, col, "?", false); drawn[t] = true
        elseif s == 0 and... (7 KB left)
