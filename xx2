    if type(c) == "table" and c[1] and c[2] and c[3] then
        GREEN_KEYS[MakeKey(c[1], c[2], c[3])] = true
    end
end
for _, c in ipairs(CFG.RevealedColors) do
    if type(c) == "table" and c[1] and c[2] and c[3] then
        BEIGE_KEYS[MakeKey(c[1], c[2], c[3])] = true
    end
end

-- [PALETTE] runtime-learned palette
local LearnedCovered = {}
local LearnedRevealed = {}

local function IsRevealedKey(k)
    return BEIGE_KEYS[k] == true or LearnedRevealed[k] == true
end

local function IsCoveredKey(k)
    if LearnedRevealed[k] then return false end
    return GREEN_KEYS[k] == true or LearnedCovered[k] == true
end

local function ResetLearnedPalette()
    LearnedCovered = {}
    LearnedRevealed = {}
end

local Pool = {}
