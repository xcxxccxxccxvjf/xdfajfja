local function TileGridPos(t)
    local step = TileStep or (GridStep and GridStep.X)
    if not step then return nil, nil end
    return math.round(t.Position.X / step),
           math.round(t.Position.Z / (TileStep or GridStep.Z))
end

local function IsEdge(gx, gz)
    return GridW and GridH
       and (gx <= 1 or gx >= GridW or gz <= 1 or gz >= GridH)
end

local function IsCorner(gx, gz)
    return GridW and GridH
       and (gx <= 1 or gx >= GridW) and (gz <= 1 or gz >= GridH)
end

local function RefreshBounds()
    BoundsDirty = false
    if GridW and GridH then
        BoardBounds = { MinX=1, MinZ=1, W=GridW, H=GridH }
        return
    end
    local minX, minZ, maxX, maxZ = math.huge, math.huge, -math.huge, -math.huge
    for t in next, Adjacency do
        local gx, gz = TileGridPos(t)
        if gx then
            if gx < minX then minX = gx end
            if gx > maxX then maxX = gx end
            if gz < minZ then minZ = gz end
            if gz > maxZ then maxZ = gz end
        end
    end
    BoardBounds = (minX < math.huge)
        and { MinX=minX, MinZ=minZ, W=maxX-minX+1, H=maxZ-minZ+1 } -- [PALETTE] typo fix (was maxZ-minX)
        or nil
end

local FlagModelNames = {}

local function Reflag()
    local t = {}
    local flagFolder = FlagsRoot or workspace:FindFirstChild("Flag")
    if flagFolder then
        local subFolders = flagFolder:GetChildren()
        for i = 1, #subFolders do
            local sub = subFolders[i]
            if sub:IsA("Folder") then
                local models = sub:GetChildren()
                for j = 1, #models do
                    t[models[j].Name] = true
                end
            end
        end
    end
    FlagModelNames = t
end
Reflag()

local function HasFlag(tile)
    local children = tile:GetChildren()
    for i = 1, #children do
        local c = children[i]
        if c:IsA("Model") and FlagModelNames[c.Name] then return true end
    end
    return false
end

local function GetNumber(tile)
    local g = tile:FindFirstChild("NumberGui")
    local l = g and g:FindFirstChild("TextLabel")
    return (l and tonumber(l.Text)) or 0
end

-- [PALETTE] diagnostic dump (only runs when CFG.Debug is true)
local function DumpDiagnostics()
    local counts, order = {}, {}
    local sample = nil
    for t in next, Adjacency do
        sample = sample or t
        local k = RGBKey(t.Color)
        local e = counts[k]
        if not e then
            e = { n = 0, num = 0, flag = 0, c = t.Color, mat = t.Material.Name }
            counts[k] = e
            order[#order+1] = k
        end
        e.n += 1
        if GetNumber(t) > 0 then e.num += 1 end
        if HasFlag(t) then e.flag += 1 end
    end
    print(("[PhantomBit] %d tiles, %d distinct colours"):format(TileCount, #order))
    for i = 1, #order do
        local k = order[i]
        local e = counts[k]
        print(("[PhantomBit]  RGB(%d,%d,%d) count=%d numbered=%d flagged=%d material=%s covered=%s revealed=%s"):format(
            math.round(e.c.R * 255), math.round(e.c.G * 255), math.round(e.c.B * 255),
            e.n, e.num, e.flag, e.mat,
            tostring(IsCoveredKey(k)), tostring(IsRevealedKey(k))))
    end
    if sample then
        local names = {}
        local ch = sample:GetChildren()
        for i = 1, #ch do names[#names+1] = ch[i].Name .. ":" .. ch[i].ClassName end
        print("[PhantomBit] sample tile children: " .. table.concat(names, ", "))
        for name, value in next, sample:GetAttributes() do
            print("[PhantomBit] sample tile attribute: " .. tostring(name) .. " = " .. tostring(value))
        end
    end
end

local function triggerTileTouch(targetTile)
    if not targetTile or not targetTile:IsDescendantOf(workspace) then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if (hrp.Position - targetTile.Position).Magnitude > 50 then return end
    local limb = char:FindFirstChild("RightFoot") 
        or char:FindFirstChild("Right Leg") 
        or char:FindFirstChild("LeftFoot") 
        or char:FindFirstChild("Left Leg")
        or hrp
    if not limb then return end
    if typeof(firetouchinterest) == "function" then
        firetouchinterest(limb, targetTile, 0)
        firetouchinterest(limb, targetTile, 1)
    end
end

local function triggerTileFlag(targetTile)
    if not targetTile or not targetTile:IsDescendantOf(workspace) then return end
    if HasFlag(targetTile) then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or (hrp.Position - targetTile.Position).Magnitude > 50 then return end
    local cd = targetTile:FindFirstChildOfClass("ClickDetector") or targetTile:FindFirstChildWhichIsA("ClickDetector", true)
    if cd and typeof(fireclickdetector) == "function" then
        fireclickdetector(cd, 1)
        fireclickdetector(cd, 0)
    end
end

